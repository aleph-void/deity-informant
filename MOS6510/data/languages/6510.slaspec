# SLEIGH spec for the NMOS 6510 (6502 + undocumented opcodes), as used on the Commodore 64.
# 6502_base.sinc is Ghidra's stock 6502 spec with hardware corrections (see its header and CREDITS.md);
# 6510_illegal.sinc adds the 105 undocumented opcodes; 6510_smc.sinc (generated by
# deity_informant/sleigh/smc.py) adds the self-modifying-code overlay selected by context bits.
@include "6502_base.sinc"
@include "6510_illegal.sinc"
@include "6510_smc.sinc"
