<?xml version="1.0" encoding="UTF-8"?>

<processor_spec>
  <programcounter register="PC"/>

  <!-- The 6510's on-chip I/O port (data direction register at $00, port at $01) and the C64 I/O window:
       the VIC-II, SID, colour RAM and CIAs are not RAM, so reads must not fold.  The port also switches
       the BASIC ROM, I/O/character ROM and KERNAL ROM in and out of the address space; Ghidra's address
       map is static, so that banking is documented (see GHIDRA-RARE.md), not modelled. -->
  <volatile outputop="write_volatile" inputop="read_volatile">
    <range space="RAM" first="0x0000" last="0x0001"/>
    <range space="RAM" first="0xd000" last="0xdfff"/>
  </volatile>

  <default_symbols>
    <symbol name="NMI" address="FFFA" entry="true" type="code_ptr"/>
    <symbol name="RES" address="FFFC" entry="true" type="code_ptr"/>
    <symbol name="IRQ" address="FFFE" entry="true" type="code_ptr"/>
    <symbol name="CPU_DDR" address="0000"/>
    <symbol name="CPU_PORT" address="0001"/>
    <symbol name="CINV" address="0314" type="code_ptr"/>
    <symbol name="CBINV" address="0316" type="code_ptr"/>
    <symbol name="NMINV" address="0318" type="code_ptr"/>
    <symbol name="IOPEN" address="031A" type="code_ptr"/>
    <symbol name="ICLOSE" address="031C" type="code_ptr"/>
    <symbol name="ICHKIN" address="031E" type="code_ptr"/>
